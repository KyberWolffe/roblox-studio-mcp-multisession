            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "source_byte_limit": {
            "type": "integer",
            "minimum": 262144,
            "maximum": 4194304
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "time_limit_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10000
          },
          "continuation_cursor": {
            "type": "string",
