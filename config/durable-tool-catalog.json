    {
      "name": "studio_grep_scripts",
      "description": "Search bounded script source bytes for one literal query beneath one exact Studio instance path. Results use deterministic pagination, bounded previews, revision hashes, and an opaque continuation cursor fenced to the explicit session, document, generation, query, ordering, and continuation lineage.",
